rules_version = '2';

// Studio 11 Interior
// - Website content: anyone can read; only the admin account can change it.
// - Enquiries: anyone can SEND one (checked below); only the admin can see,
//   change or delete them.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "studio11interior.db@gmail.com";
    }

    function shortText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // A new enquiry from the chat or the booking form: only these fields,
    // a real 10-digit Indian mobile number, status "new" and the server's own time.
    function validEnquiry(d) {
      return d.keys().hasOnly(["name", "phone", "area", "need", "home", "homeStatus", "budget", "start", "type", "source", "status", "createdAt"])
        && d.keys().hasAll(["name", "phone", "source", "status", "createdAt"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.phone is string && d.phone.matches("^[6-9][0-9]{9}$")
        && d.source in ["chat", "form"]
        && d.status == "new"
        && d.createdAt == request.time
        && shortText(d, "area", 80)
        && shortText(d, "need", 200)
        && shortText(d, "home", 60)
        && shortText(d, "homeStatus", 60)
        && shortText(d, "budget", 40)
        && shortText(d, "start", 40)
        && shortText(d, "type", 40);
    }

    // Brand, hero, services, gallery, reviews, contact details...
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leads from the website
    match /enquiries/{id} {
      allow create: if validEnquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
